NEXT_PUBLIC_SUPABASE_URL=https://ACCOINT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-for-server-side-admin-actions

# vahandetails.com RC API key — powers the "Refresh from RTO" button on /alerts
# (refreshes insurance / fitness / pollution expiry). Test_1234 is the shared
# demo key (rate-limited, may be revoked); use a paid key in production.
VAHANDETAILS_API_KEY=Test_1234
# VAHANDETAILS_TIMEOUT_MS=15000

# TransportBook Vahan Info fetcher config for vehicle-info/scripts/fetch-vahan-info.mjs
# Keep VAHAN_MAX_REQUESTS=1 to respect the website's free daily lookup limit.
VAHAN_MAX_REQUESTS=1
VAHAN_DELAY_MS=2000
VAHAN_BROWSER_HEADLESS=0
VAHAN_OVERWRITE=0
VAHAN_SAVE_RAW=0
VAHAN_KEEP_BROWSER_OPEN=0
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
