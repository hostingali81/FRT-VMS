NEXT_PUBLIC_SUPABASE_URL=https://ACCOINT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-for-server-side-admin-actions

# Cars24 service-history API powers the "Refresh from RTO" button on /alerts
# (insurance / fitness / pollution expiry). No key needed — the endpoint is
# public. Cloudflare may block it from datacenter IPs; `npm run rto:refresh`
# runs the same refresh from your own connection as a fallback.
# CARS24_TIMEOUT_MS=12000
